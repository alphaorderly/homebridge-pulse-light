{
  "name": "homebridge-pulse-light",
  "displayName": "Pulse Light",
  "type": "module",
  "version": "1.1.0",
  "description": "A virtual HomeKit light that turns on briefly at a fixed interval, for use as a periodic automation trigger.",
  "author": "alphaorderly",
  "license": "Apache-2.0",
  "homepage": "https://github.com/alphaorderly/homebridge-pulse-light#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphaorderly/homebridge-pulse-light.git"
  },
  "bugs": {
    "url": "https://github.com/alphaorderly/homebridge-pulse-light/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homekit",
    "homebridge",
    "lightbulb",
    "pulse",
    "timer",
    "virtual",
    "automation"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "config.schema.json"
  ],
  "engines": {
    "node": "^22.10.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "prepublishOnly": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@homebridge/hap-nodejs": "^2.2.2",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.0",
    "globals": "^16.5.0",
    "homebridge": "^2.4.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
